<UserControl x:Class="SuperScroll.Controls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SuperScroll;component/Controls/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SsPage}">
        <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">

            <TextBlock Text="SuperScroll" Style="{StaticResource SsPageTitle}"/>
            <TextBlock Style="{StaticResource SsPageSubtitle}"
                       Text="Replaces Playnite's scrolling with frame-synced, pixel-accurate motion. Applies to every list in the application, including ones your theme creates."/>

            <!-- Top rail. Page bodies bind Visibility to these directly, so no code-behind. -->
            <Border Style="{StaticResource SsRail}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabDesktop" Style="{StaticResource SsRailTab}"
                                 GroupName="SsPages" Content="Mouse Wheel" IsChecked="True"/>
                    <RadioButton x:Name="TabFullscreen" Style="{StaticResource SsRailTab}"
                                 GroupName="SsPages" Content="Fullscreen"/>
                    <RadioButton x:Name="TabAdvanced" Style="{StaticResource SsRailTab}"
                                 GroupName="SsPages" Content="Advanced"/>
                </StackPanel>
            </Border>

            <!-- ============================ MOUSE WHEEL ============================ -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabDesktop, Converter={StaticResource BoolToVis}}">

                <CheckBox Style="{StaticResource SsToggle}" Content="Enable smooth scrolling"
                          IsChecked="{Binding Settings.EnableSmoothScrolling}"/>
                <TextBlock Style="{StaticResource SsHint}"
                           Text="Default: On. Turn off to hand scrolling back to Playnite — no restart needed. This is the master switch: it governs the Fullscreen page too."/>

                <StackPanel IsEnabled="{Binding Settings.EnableSmoothScrolling}">

                    <StackPanel Orientation="Horizontal" Margin="28,8,0,0">
                        <TextBlock Text="Preset" Style="{StaticResource SsLabel}"/>
                        <ComboBox Style="{StaticResource SsCombo}" Width="286"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource SsPresetRow}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,6,0,14"
                               Text="Sets all three sliders at once. Move any slider afterwards and this reads Custom."/>

                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Smoothness" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="0.05" Maximum="0.95"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Smoothing}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.Smoothing, StringFormat='{}{0:0.00}'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,12"
                               Text="How much of the remaining distance is covered each frame. Lower glides for longer, higher snaps into place. Shared with Fullscreen. Default 0.25."/>

                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Lines per notch" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="1" Maximum="12"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.LinesPerNotch}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.LinesPerNotch, StringFormat='{}{0:0.#}'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,12"
                               Text="How far one wheel notch travels. Windows' own default is 3. Default 3."/>

                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Line height" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="8" Maximum="200"
                                TickFrequency="4" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.LineHeightPixels}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.LineHeightPixels, StringFormat='{}{0:0} px'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,12"
                               Text="The pixel height one line stands for. Raise it if a notch feels short in grid views, lower it for dense list views. Default 48."/>

                </StackPanel>
            </StackPanel>

            <!-- ============================= FULLSCREEN ============================= -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabFullscreen, Converter={StaticResource BoolToVis}}">

                <TextBlock Style="{StaticResource SsHintFlush}" Margin="0,0,0,14"
                           Text="Fullscreen is driven by a controller or the keyboard, not the wheel. Moving the selection is what scrolls the list, so these settings smooth a different path from the one above — the wheel still follows the Mouse Wheel page in either mode."/>

                <Border Style="{StaticResource SsSectionBar}">
                    <TextBlock Text="CONTROLLER &amp; KEYBOARD" Style="{StaticResource SsSectionTitle}"/>
                </Border>

                <CheckBox Style="{StaticResource SsToggle}" Content="Smooth controller and keyboard navigation"
                          IsChecked="{Binding Settings.EnableNavigationSmoothing}"
                          IsEnabled="{Binding Settings.EnableSmoothScrolling}"/>
                <TextBlock Style="{StaticResource SsHint}"
                           Text="Default: Off. Eases the scroll that follows a selection change. The list itself is left exactly where Playnite put it and only the content slides into place, so it cannot fight Playnite&apos;s &quot;keep the selection visible&quot; behaviour. Uses the Smoothness value from the Mouse Wheel page."/>

                <StackPanel IsEnabled="{Binding Settings.EnableNavigationSmoothing}">
                    <StackPanel Orientation="Horizontal" Margin="28,8,0,0">
                        <TextBlock Text="Hold debounce" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="0" Maximum="300"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.NavigationDebounceMs}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.NavigationDebounceMs, StringFormat='{}{0:0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,6,0,4"
                               Text="A held controller repeats every 80 ms, a held key about every 31 ms. Animating every repeat leaves the scroll chasing a selection that has already moved on, so very fast repeats land instantly instead."/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,0,0,4"
                               Text="Moves closer together than this land instantly — there is no time to show an animation between them, and trying leaves the content trailing the selection. Anything slower animates. Large jumps such as Page Up and Page Down always land instantly."/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,0,0,14"
                               Text="The default of 60 ms sits between those two rates, so a held controller still animates while a held key does not. Raise it if held navigation feels loose, lower it for more animation, or set 0 to animate every move. Default 60 ms."/>
                </StackPanel>

                <Border Style="{StaticResource SsSectionBar}">
                    <TextBlock Text="HOLD REPEAT (KEYBOARD)" Style="{StaticResource SsSectionTitle}"/>
                </Border>

                <TextBlock Style="{StaticResource SsHintFlush}" Margin="0,0,0,10"
                           Text="Holding an arrow key waits out Windows' own repeat delay before the selection moves — 500 ms on a default install. Windows' setting only offers 250, 500, 750 or 1000 ms, and applies to every application. This replaces it inside Playnite only, with no floor."/>

                <CheckBox Style="{StaticResource SsToggle}" Content="Use SuperScroll's key repeat instead of Windows'"
                          IsChecked="{Binding Settings.EnableKeyRepeatOverride}"/>
                <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,10"
                           Text="Default: Off. Applies to the arrow keys and Page Up / Page Down while navigating. Typing is never affected — a held arrow inside a search box is left to the text box. Nothing outside Playnite changes."/>

                <StackPanel IsEnabled="{Binding Settings.EnableKeyRepeatOverride}">
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Hold delay" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="50" Maximum="600"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.KeyRepeatInitialDelayMs}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.KeyRepeatInitialDelayMs, StringFormat='{}{0:0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,12"
                               Text="How long a key must be held before it starts repeating. Windows cannot go below 250 ms here; this can. Default 180 ms."/>

                    <CheckBox Style="{StaticResource SsToggle}" Margin="28,6,0,0"
                              Content="Repeat as fast as the list can keep up"
                              IsChecked="{Binding Settings.PaceRepeatToLayout}"/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="56,4,0,4"
                               Text="Default: Off. Instead of repeating on a fixed clock, waits for each move to finish drawing before making the next one. The speed becomes whatever your library can actually sustain — quick with small covers, easing off where tiles are expensive."/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="56,0,0,12"
                               Text="This also removes the cause of the selection jumping to the top: Playnite prepares only one row beyond the view, so a repeat that outruns drawing lands on a tile that does not exist yet and focus is lost. Waiting for the draw means it always does."/>

                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0"
                                IsEnabled="{Binding IsRepeatIntervalEnabled}">
                        <TextBlock Text="Repeat interval" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="15" Maximum="250"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.KeyRepeatIntervalMs}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.KeyRepeatIntervalMs, StringFormat='{}{0:0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,4"
                               Text="Time between moves once it is repeating. Lower is faster. Default 45 ms — about 22 moves a second. Unavailable while the option above is on, which sets the rate itself."/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,0,0,14"
                               Text="If holding a direction eventually throws you back to the top of the list, turn on debug logging: SuperScroll.log will say whether Playnite reset the selection itself or focus moved out of the list. The two need different fixes and look identical on screen."/>
                </StackPanel>

                <Border Style="{StaticResource SsSectionBar}">
                    <TextBlock Text="HOLD REPEAT (PLAYNITE)" Style="{StaticResource SsSectionTitle}"/>
                </Border>

                <TextBlock Style="{StaticResource SsHintFlush}" Margin="0,0,0,6"
                           Text="The pause before a held direction starts repeating is Playnite's own, not SuperScroll's: it waits 700 ms after the first press, then repeats every 80 ms. That pause is the one most people feel, and Playnite offers no setting for it."/>

                <TextBlock Style="{StaticResource SsWarning}" Margin="0,0,0,10"
                           Text="&#x26A0; Controller only. Playnite's repeat timings govern input it generates from a gamepad — it simulates the arrow keys rather than reading them. A physical keyboard held down repeats at Windows' own typematic rate instead, which is set in Control Panel → Keyboard (Repeat delay and Repeat rate) and cannot be changed by any extension."/>

                <CheckBox Style="{StaticResource SsToggle}" Content="Override Playnite's hold repeat timings (controller)"
                          IsChecked="{Binding Settings.EnableInputRepeatPatch}"/>
                <TextBlock Style="{StaticResource SsWarning}" Margin="28,4,0,4"
                           Text="&#x26A0; Off by default. This is the only option here that reaches into Playnite itself rather than working through the interface, so it may stop having any effect after a Playnite update."/>
                <TextBlock Style="{StaticResource SsHint}" Margin="28,0,0,10"
                           Text="It changes nothing permanently: Playnite's own values are read first and put back when you switch this off, when the plugin is disabled, and when Playnite closes."/>

                <StackPanel IsEnabled="{Binding Settings.EnableInputRepeatPatch}">
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Hold delay" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="100" Maximum="700"
                                TickFrequency="25" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.RepeatDelayMs}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.RepeatDelayMs, StringFormat='{}{0:0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,12"
                               Text="How long a direction must be held before it starts repeating. Playnite's own value is 700 ms; this only ever lowers it. Default 300 ms."/>

                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBlock Text="Repeat rate" Style="{StaticResource SsLabel}"/>
                        <Slider Style="{StaticResource SsSlider}" Width="230"
                                Minimum="20" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.RepeatRateMs}"/>
                        <TextBlock Style="{StaticResource SsValue}"
                                   Text="{Binding Settings.RepeatRateMs, StringFormat='{}{0:0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,4,0,4"
                               Text="Interval between repeats once it starts. Playnite's own value is 80 ms. Default 60 ms."/>
                    <TextBlock Style="{StaticResource SsHint}" Margin="28,0,0,14"
                               Text="Setting this below the Hold debounce above means held navigation stops animating, because every repeat then counts as held. Keep the debounce lower than this if you want to see the smoothing while holding."/>
                </StackPanel>
            </StackPanel>

            <!-- ============================== ADVANCED ============================== -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabAdvanced, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource SsSectionBar}">
                    <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SsSectionTitle}"/>
                </Border>

                <CheckBox Style="{StaticResource SsToggle}" Content="Enable debug logging"
                          IsChecked="{Binding Settings.EnableDebugLogging}"/>
                <TextBlock Style="{StaticResource SsHint}"
                           Text="Writes SuperScroll.log to the plugin's data folder. Off by default — scroll input fires many times a second."/>

                <TextBlock Style="{StaticResource SsHintFlush}" Margin="0,10,0,0"
                           Text="If scrolling stutters while a video plays or a background image changes, that is the interface thread being busy elsewhere — SuperScroll shortens how long it shows, but cannot remove it. Playnite's own scrolling hides it only because an instant jump needs no frames at all."/>

                <Button Style="{StaticResource SsButton}" Content="Reset to defaults"
                        Margin="0,16,0,0" Command="{Binding ResetCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
