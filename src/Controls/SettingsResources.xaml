<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The whole point of this file: a settings page hosted inside somebody else's WPF application
      inherits that application's decisions unless it states its own.

      Foreground, FontSize, FontFamily and FontWeight are INHERITABLE. A TextBlock that leaves
      Foreground unset takes it from the Playnite window, which may be near-white on a light theme
      and near-black on a dark one - and the page has no idea which. That is how a settings page
      ends up invisible on a theme its author never installed.

      So every style below states its colours and metrics outright, and the page paints its own
      background, so the contrast pair is decided here rather than borrowed. The rule is the same
      one UniPlaySong's SettingsResources.xaml follows, and for the same reason.

      Implicit styles are the other half. A theme's `<Style TargetType="{x:Type CheckBox}">`
      applies to any CheckBox without an explicit Style - so every control here gets one, even when
      the setters look redundant.
    -->

    <!-- Palette. Self-contained and deliberately dark: the page carries its own ground so it looks
         the same under every theme, rather than half-adopting the host's. -->
    <SolidColorBrush x:Key="SsGround"      Color="#12161C"/>
    <SolidColorBrush x:Key="SsSurface"     Color="#1A212B"/>
    <SolidColorBrush x:Key="SsSurfaceHi"   Color="#232C38"/>
    <SolidColorBrush x:Key="SsStroke"      Color="#2E3A48"/>
    <SolidColorBrush x:Key="SsStrokeHi"    Color="#46596D"/>
    <SolidColorBrush x:Key="SsAccent"      Color="#5BD1B0"/>
    <SolidColorBrush x:Key="SsWarn"       Color="#C8A24B"/>
    <SolidColorBrush x:Key="SsText"        Color="#E6EBF2"/>
    <SolidColorBrush x:Key="SsTextMuted"   Color="#94A3B4"/>
    <SolidColorBrush x:Key="SsTextFaint"   Color="#6B7A88"/>

    <!-- Page shell -->

    <Style x:Key="SsPage" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="{StaticResource SsGround}"/>
        <Setter Property="Padding" Value="22,18,22,22"/>
    </Style>

    <!-- Type -->

    <Style x:Key="SsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SsTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- FontWeight is stated, not inherited: a theme's implicit TextBlock style would otherwise
         decide it, which is exactly how UniPlaySong's hints came out unintentionally bold. -->
    <Style x:Key="SsHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SsTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="28,2,0,12"/>
    </Style>

    <Style x:Key="SsHintFlush" TargetType="TextBlock" BasedOn="{StaticResource SsHint}">
        <Setter Property="Margin" Value="0,2,0,12"/>
    </Style>

    <Style x:Key="SsWarning" TargetType="TextBlock" BasedOn="{StaticResource SsHint}">
        <Setter Property="Foreground" Value="{StaticResource SsWarn}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="112"/>
    </Style>

    <Style x:Key="SsValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SsAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="MinWidth" Value="58"/>
    </Style>

    <!-- Section bar: a short accent rule rather than a heavy header. -->

    <Style x:Key="SsSectionBar" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource SsAccent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="10,1,0,1"/>
        <Setter Property="Margin" Value="0,16,0,10"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
    </Style>

    <!-- Controls.

         Each is fully templated rather than merely recoloured. Setting Foreground alone is not
         enough: a theme's implicit style also carries Padding, Height and often a Template of its
         own, and those still land on a control that has no explicit Style of its own. -->

    <!--
      The "wind" toggle.

      Deliberately neither the iOS pill nor the Windows 11 switch. The read is airflow: the track is
      a channel carved into the surface, the knob is a smooth object resting in it, and switching on
      sends a current through the channel that the knob has been pushed along by.

      Morphic depth comes from gradients rather than blur effects. A DropShadowEffect on every
      toggle would put a render-target allocation behind each one, which is a poor trade on a page
      that exists to make the application feel lighter. A two-stop vertical gradient plus a
      one-pixel light edge reads as inset for free.

      The colour change is done by cross-fading two stacked tracks, not by animating a gradient's
      stops. Animating stops means either replacing the brush - which drops the transition - or
      animating each stop separately and keeping them in sync by hand. Opacity on the upper layer
      is one animation and cannot desynchronise.
    -->

    <!-- Track, off: a channel cut into the surface. Darker at the top is what sells "recessed",
         because it implies light arriving from above. -->
    <LinearGradientBrush x:Key="SsTrackOff" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C1015" Offset="0"/>
        <GradientStop Color="#161D26" Offset="0.55"/>
        <GradientStop Color="#1C2530" Offset="1"/>
    </LinearGradientBrush>

    <!-- Track, on: the current. Horizontal, so it runs along the channel in the direction the
         knob travels rather than across it. -->
    <LinearGradientBrush x:Key="SsTrackOn" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1F6E5C" Offset="0"/>
        <GradientStop Color="#3FA98D" Offset="0.45"/>
        <GradientStop Color="#69DCBB" Offset="1"/>
    </LinearGradientBrush>

    <!-- Knob: lit from above, so it reads as a sphere in the channel rather than a flat disc. -->
    <LinearGradientBrush x:Key="SsKnob" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBFDFF" Offset="0"/>
        <GradientStop Color="#E2E9F1" Offset="0.5"/>
        <GradientStop Color="#B9C6D4" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="SsToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">

                        <Grid Width="46" Height="22" VerticalAlignment="Center" SnapsToDevicePixels="True">

                            <Border CornerRadius="11" Background="{StaticResource SsTrackOff}"
                                    BorderBrush="#0A0E13" BorderThickness="1"/>

                            <!-- The lip: a hairline of lighter colour along the bottom inner edge,
                                 which is where light would collect in a real groove. One Border,
                                 no effect, and it does most of the work of selling the depth. -->
                            <Border CornerRadius="11" BorderThickness="0,0,0,1" BorderBrush="#26313D"
                                    Margin="1,1,1,1"/>

                            <Grid x:Name="OnLayer" Opacity="0">
                                <Border CornerRadius="11" Background="{StaticResource SsTrackOn}"
                                        BorderBrush="#7FE9CC" BorderThickness="1"/>
                                <!-- Streaks: the current made visible. Left-aligned so they trail
                                     behind the knob once it has travelled. -->
                                <Canvas>
                                    <Rectangle Canvas.Left="7"  Canvas.Top="7"  Width="11" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="#FFFFFF" Opacity="0.38"/>
                                    <Rectangle Canvas.Left="10" Canvas.Top="10.5" Width="8"  Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="#FFFFFF" Opacity="0.26"/>
                                    <Rectangle Canvas.Left="7"  Canvas.Top="14" Width="6"  Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="#FFFFFF" Opacity="0.30"/>
                                </Canvas>
                            </Grid>

                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     Fill="{StaticResource SsKnob}"
                                     Stroke="#5A6A7A" StrokeThickness="0.6"/>
                        </Grid>

                        <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Eased, not linear. A plugin whose entire purpose is
                                             making motion feel good should not ship a toggle that
                                             moves at a constant rate. -->
                                        <ThicknessAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="27,0,0,0" Duration="0:0:0.20">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="3,0,0,0" Duration="0:0:0.20">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Stroke" Value="#8FA3B6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SsSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource SsAccent}"/>
        <Setter Property="Background" Value="{StaticResource SsSurfaceHi}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- Transparent, not empty: a zero-size template makes the
                                                 track un-clickable, and IsMoveToPointEnabled depends on
                                                 the repeat buttons receiving the hit. -->
                                            <Border Background="Transparent" Height="18">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource SsAccent}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="18"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource SsText}"
                                                     Stroke="{StaticResource SsGround}"
                                                     StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset dropdown.
         Fully templated for the same reason everything else here is: a theme's implicit ComboBox
         style would otherwise supply the popup chrome and the item colours, and a popup is the
         worst place to discover that - it renders over the page, so an unreadable one is unreadable
         against content rather than against a known background. -->

    <Style x:Key="SsComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="12,7" BorderThickness="0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SsSurfaceHi}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#16241F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SsCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SsComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face" CornerRadius="6"
                                            Background="{StaticResource SsSurface}"
                                            BorderBrush="{StaticResource SsStroke}"
                                            BorderThickness="1"
                                            Padding="12,7,10,7"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Path x:Name="Chevron" Data="M 0,0 L 4.5,5 L 9,0"
                                                  Stroke="{StaticResource SsTextMuted}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="10,1,2,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource SsStrokeHi}"/>
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource SsText}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource SsAccent}"/>
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource SsAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              VerticalAlignment="Center"/>
                        </ToggleButton>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <!-- MinWidth from the box so the popup never renders narrower than the
                                 control it belongs to, which looks like a rendering fault. -->
                            <Border Background="{StaticResource SsGround}"
                                    BorderBrush="{StaticResource SsStroke}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One row of the dropdown: name, the arithmetic, then what it feels like.

         A single template serves both the open list and the collapsed box, because
         ComboBox.SelectionBoxItemTemplate is read-only and cannot be given a second one. The
         difference is detected instead: WPF renders the selection box OUTSIDE any ComboBoxItem, so
         an ancestor lookup that comes back null means "this is the closed box" - and the blurb,
         which would make the control three lines tall, collapses. -->
    <DataTemplate x:Key="SsPresetRow">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource SsText}"/>
                <TextBlock x:Name="Metric"
                           Text="{Binding PixelsPerNotch, StringFormat=' · {0:0}px per notch'}"
                           FontFamily="Consolas" FontSize="10.5"
                           Foreground="{StaticResource SsAccent}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Blurb"
                       Text="{Binding Blurb}" FontSize="10.5" FontWeight="Normal"
                       Foreground="{StaticResource SsTextMuted}" TextWrapping="Wrap"
                       MaxWidth="330" Margin="0,2,0,0"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Value="{x:Null}"
                         Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}">
                <Setter TargetName="Blurb" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <!-- Custom has no numbers of its own, so the metric would read "0px per notch". -->
            <DataTrigger Binding="{Binding IsCustom}" Value="True">
                <Setter TargetName="Metric" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Top rail tab. A RadioButton because the pages are mutually exclusive and grouping is
         then WPF's job rather than code-behind's; the page bodies bind their Visibility straight
         to IsChecked, so there is no selected-index state to keep in sync. -->
    <Style x:Key="SsRailTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SsTextMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab" Background="Transparent" Padding="15,9"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SsText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SsAccent}"/>
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource SsAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SsRail" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SsStroke}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Margin" Value="0,4,0,18"/>
    </Style>

    <Style x:Key="SsButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SsText}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="4"
                            Background="{StaticResource SsSurface}"
                            BorderBrush="{StaticResource SsStroke}"
                            BorderThickness="1"
                            Padding="14,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SsSurfaceHi}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource SsStrokeHi}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
